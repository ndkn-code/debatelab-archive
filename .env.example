# DebateLab Environment Variables
# Copy this file to .env.local and fill in your API keys

# Supabase Configuration
# Get these from your Supabase project: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Secures /api/cron/smart-popups. Must match the Vercel Cron Authorization bearer token.
CRON_SECRET=replace-with-a-long-random-secret

# Set to false to temporarily disable in-app smart feature popup eligibility.
SMART_POPUPS_ENABLED=true

# Google Gemini API Key (for AI debate feedback)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model for debate analysis (optional, defaults to gemini-2.5-flash)
# Supported: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Deepgram API Key (for real-time speech-to-text)
# Get yours at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Beta access flag
# Defaults to true in code. Set to false to enforce premium/enterprise subscription gates.
BETA_ALL_ACCESS=true

# Local admin QA only. Ignored in production unless NODE_ENV is not production.
DEV_ADMIN_BYPASS=false

# Groq API Key (AI Coach chat uses Groq-hosted Llama models)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional, defaults to llama-3.3-70b-versatile
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Optional: emit structured coach metadata alongside chat replies
ENABLE_COACH_METADATA=false

# Optional: PostHog product analytics (leave empty to disable)
NEXT_PUBLIC_POSTHOG_KEY=

# Optional: show mock history metrics for one demo account (leave empty to disable)
NEXT_PUBLIC_DEMO_METRICS_EMAIL=
